<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Видео и звук звонка. Разрешения спрашиваются перед первым запросом помощи. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service на время поиска и звонка (CallForegroundService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+: без разрешения уведомление сервиса не видно в шторке (сам сервис работает).
         Спрашивается вместе с камерой и микрофоном (BlindHelpRoute), волонтёру понадобится и для push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Камера нужна, но приложение ставится и на устройства без задней камеры (возьмёт любую). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application>
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

</manifest>
