# Скопируйте в infra/.env и заполните. Файл .env в git не попадает.
# Для локальной разработки подойдут любые значения, например сгенерированные `openssl rand -hex 16`.

POSTGRES_DB=ryadom
POSTGRES_USER=ryadom
POSTGRES_PASSWORD=

# Ключ и секрет API LiveKit. Секрет — не короче 32 символов.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# IP-адрес этого компьютера, который LiveKit сообщает клиентам для видео.
# Пусто — 127.0.0.1: работает браузер на этом же компьютере, а также эмулятор Android
# и телефон по USB после `adb reverse` (README, «Android») — так проще всего.
# Только для телефона по Wi-Fi без USB укажите адрес компьютера в локальной сети
# (Windows: `ipconfig`, строка «IPv4-адрес», например 192.168.1.10).
# Для настоящего телефона брандмауэр компьютера должен пропускать входящие подключения
# из локальной сети: TCP 7880 (сигнализация LiveKit), TCP 7881 и UDP 50000–50100 (видео и звук),
# TCP 8080 (backend). Эмулятору и браузеру на этом же компьютере это не нужно.
LIVEKIT_NODE_IP=

# --- Backend (./gradlew :backend:run читает этот же файл) ---

# Секрет подписи токенов входа (JWT), не короче 32 символов. Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Вход без OAuth (POST /auth/dev) — удобно для разработки. На боевом сервере всегда false.
AUTH_DEV_ENABLED=true

# Вход через Яндекс ID: приложение регистрируется на https://oauth.yandex.ru (доступ login:info).
# Пусто — вход через Яндекс выключен.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Адрес LiveKit, который backend сообщает клиентам для звонка. Пусто — ws://localhost:7880
# (браузер на этом компьютере, эмулятор и телефон по USB после `adb reverse`).
# Для телефона по Wi-Fi — адрес компьютера в сети, тот же, что в LIVEKIT_NODE_IP, например ws://192.168.1.10:7880.
LIVEKIT_URL=
