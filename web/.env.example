# Переменные сборки веб-приложения. Скопируйте в web/.env.local и заполните; .env.local в git не попадает.
# Значения попадают в код сайта и видны любому посетителю — секретов здесь быть не должно.

# client_id приложения в Яндекс ID (https://oauth.yandex.ru, тот же, что YANDEX_CLIENT_ID у backend).
# В настройках приложения нужен Callback URI с адресом сайта: для разработки — http://localhost:5173/
# Пусто — кнопки «Войти через Яндекс ID» нет.
VITE_YANDEX_CLIENT_ID=

# true — вход без OAuth и страница «тестовый незрячий» и в собранной версии (только для тестового сервера).
# В режиме разработки (npm run dev) они включены всегда.
VITE_DEV_TOOLS=
